# Copy to .env for local development. Every setting can also be passed as an environment variable.

ENV=dev
DATABASE_URL=postgresql+psycopg://rafkhata:rafkhata@localhost:5432/rafkhata
# URL the phone uses to reach the API (an emulator reaches your laptop at http://10.0.2.2:8000)
PUBLIC_BASE_URL=http://localhost:8000

# --- Auth ---
# Use a long random value in production:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-insecure-change-me
# Google OAuth *Web* client ID(s), comma-separated. The Android app requests ID tokens for this client.
GOOGLE_CLIENT_IDS=
# Lets anyone sign in with only an email. Development and CI only; must be false in production.
DEV_LOGIN_ENABLED=true

# --- Storage: "local" (disk, dev) or "s3" (Cloudflare R2 / MinIO / AWS) ---
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./data/storage
# S3_BUCKET=raf-khata
# S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# --- Speech recognition: sarvam | soniox | mock ---
ASR_PRIMARY=mock
ASR_FALLBACK=none
# SARVAM_API_KEY=
# SARVAM_MODEL=saaras:v3
# SARVAM_MODE=codemix
# SONIOX_API_KEY=
# SONIOX_MODEL=stt-async-v5

# --- Notes LLM: claude | fake ---
LLM_PROVIDER=fake
# ANTHROPIC_API_KEY=
# LLM_MODEL=claude-opus-5-5
# LLM_EFFORT_CORRECT=low
# LLM_EFFORT_NOTES=medium
# LLM_EFFORT_STUDY=low

# --- Pipeline ---
VAD_TRIM=true
RAW_AUDIO_RETENTION_DAYS=30
DEFAULT_TIMEZONE=Asia/Dhaka
WORK_DIR=./data/work

# --- Push notifications (optional) ---
# FCM_PROJECT_ID=
# FCM_SERVICE_ACCOUNT_FILE=/secrets/firebase-service-account.json
